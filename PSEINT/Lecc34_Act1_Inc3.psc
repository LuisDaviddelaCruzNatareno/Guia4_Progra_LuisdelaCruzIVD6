Algoritmo Lecc34_Act1_Inc3
	Definir c, f, k Como Real
	
	Escribir "Nombre: Luis de la Cruz"
	Escribir "Grado y sección: IVD"
	Escribir "Clave: 6"
	Escribir "--- CONVERSOR DE TEMPERATURA ---"
	
	Escribir "Ingrese grados Centígrados:"
	Leer c
	
	f <- (c * 9 / 5) + 32
	k <- c + 273.15
	
	Escribir "a. Fahrenheit: ", f
	Escribir "b. Celsius: ", c
	Escribir "c. Kelvin: ", k
FinAlgoritmo
